# APP_URL: Public base URL of the site. Used for OAuth callbacks and API links.
# Locally this is the Vite dev server (the /auth and /api paths proxy to Express).
# In production set this to https://gm7.ma
APP_URL="http://localhost:3000"

# VITE_SITE_URL: Public production URL used for canonical links, sitemap.xml, and robots.txt.
# Defaults to https://gm7.ma when unset.
VITE_SITE_URL="https://gm7.ma"

# Discord OAuth application credentials.
# Create an app at https://discord.com/developers/applications and add this Redirect:
#   {APP_URL}/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Username and password for the /dashboard content editor. Change this before deploying.
# If unset, the dashboard falls back to "admin" / "gm7-admin".
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Set to "true" to open /dashboard without a login (temporary/dev only).
# Leave empty or "false" to require the password above.
ADMIN_AUTH_DISABLED=""

# Port for the Express server (API + OAuth). Vite proxies /api and /auth to it in dev.
PORT=3001

# Turso Database (LibSQL)
# Create a free database at https://turso.tech or via Turso CLI:
#   turso db create gm7-db
#   turso db show gm7-db --url
#   turso db tokens create gm7-db
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Kick channel slug used for the live status card (server-side cached proxy).
KICK_CHANNEL_SLUG="snnsei"

# Public YouTube handle used to discover the channel's RSS feed. No API key is required.
YOUTUBE_CHANNEL_HANDLE="@Snnsei"

# Public TikTok username used to read the latest videos from TikTok's embed page.
TIKTOK_USERNAME="snnsei_"

# Instagram username used for profile links and manually pinned posts.
INSTAGRAM_USERNAME="snnseii"

# Google Search Console verification token (HTML meta tag method).
# In Google Search Console (https://search.google.com/search-console) add your
# site, choose the "HTML tag" verification method, and copy the content value
# from: <meta name="google-site-verification" content="VALUE" />
# Set it here so it is baked into the built index.html. Optional.
VITE_GOOGLE_SITE_VERIFICATION=""

# Optional automatic Instagram feed. Instagram blocks anonymous scraping from
# most servers, so use either an Instagram API access token (Instagram Login)
# or a JSON/RSS feed URL from a service you control. If both are empty, the
# Instagram section shows posts pinned from the dashboard instead.
#
# Access token: the account must be Professional (Business or Creator). Create
# a Business-type Meta app, then open Instagram > API setup with Instagram
# business login > Generate token. Tokens from the dashboard last 60 days.
# (Alternatively set INSTAGRAM_FEED_URL to a JSON/RSS feed.)
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_FEED_URL=""
